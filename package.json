{
  "name": "qualy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agenda privada de entrenamientos y hábitos diarios",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/start-local-postgres.ts",
    "dev": "next dev --hostname ${QUALY_HOST:-127.0.0.1} --port ${PORT:-4317}",
    "build": "next build",
    "prestart": "node scripts/start-local-postgres.ts",
    "start": "next start --hostname ${QUALY_HOST:-127.0.0.1} --port ${PORT:-4317}",
    "test": "node --test test/*.test.ts",
    "db:import-sqlite": "node --env-file-if-exists=.env.local scripts/import-sqlite.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
